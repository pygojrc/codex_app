# Maintainer: pygojrc

pkgname=codex-app-linux
pkgver=26.715.72359
pkgrel=1
pkgdesc='Unofficial ChatGPT/Codex desktop application adapted for Linux'
arch=('x86_64')
url='https://github.com/pygojrc/codex_app'
license=('custom')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'libcups'
  'libdrm'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
optdepends=('codex: native Codex CLI and app-server')
provides=('codex-app')
options=('!strip' '!debug')
source=('codex-app.desktop')
sha256sums=('SKIP')

_project_root="${PROJECT_ROOT:-${startdir}/../..}"
_prototype="${_project_root}/build/ChatGPT-linux-${pkgver}"

package() {
  if [[ ! -d "${_prototype}" ]]; then
    error "Linux prototype does not exist: ${_prototype}"
    return 1
  fi

  install -d "${pkgdir}/opt/codex-app"
  cp -a "${_prototype}/." "${pkgdir}/opt/codex-app/"

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/codex-app" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if command -v codex >/dev/null 2>&1; then
  export CODEX_CLI_PATH="${CODEX_CLI_PATH:-$(command -v codex)}"
fi

exec /opt/codex-app/run-chatgpt-linux.sh "$@"
EOF

  install -Dm644 "${srcdir}/codex-app.desktop" \
    "${pkgdir}/usr/share/applications/codex-app.desktop"

  if [[ -f "${_prototype}/resources/codex-gui.png" ]]; then
    install -Dm644 "${_prototype}/resources/codex-gui.png" \
      "${pkgdir}/usr/share/icons/hicolor/512x512/apps/codex-app.png"
  fi

  if [[ -f "${_project_root}/LICENSE" ]]; then
    install -Dm644 "${_project_root}/LICENSE" \
      "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  elif [[ -f "${_project_root}/themes/dream-skin/LICENSE" ]]; then
    install -Dm644 "${_project_root}/themes/dream-skin/LICENSE" \
      "${pkgdir}/usr/share/licenses/${pkgname}/dream-skin-LICENSE"
  fi
}
