#!/usr/bin/env bash
set -euo pipefail

app_id="codex-app"
app_dir="/opt/codex-app"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/$app_id"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/$app_id"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/$app_id"
runtime_dir="${XDG_RUNTIME_DIR:-$state_dir/runtime}"

mkdir -p "$config_dir" "$cache_dir" "$state_dir/tmp" "$runtime_dir"
chmod 700 "$state_dir/tmp" "$runtime_dir" 2>/dev/null || true

export TMPDIR="${TMPDIR:-$state_dir/tmp}"
export CODEX_APP_SERVER_HOST="${CODEX_APP_SERVER_HOST:-127.0.0.1}"
export CODEX_APP_SERVER_PORT="${CODEX_APP_SERVER_PORT:-18767}"
export CODEX_ELECTRON_USER_DATA_PATH="${CODEX_ELECTRON_USER_DATA_PATH:-$config_dir/electron-user-data}"
export ELECTRON_ENABLE_LOGGING="${ELECTRON_ENABLE_LOGGING:-1}"

log_file="$cache_dir/launcher.log"
exec 2>>"$log_file"
echo "[$(date --iso-8601=seconds)] start display=${XDG_SESSION_TYPE:-unknown} app_server=${CODEX_APP_SERVER_HOST}:${CODEX_APP_SERVER_PORT}" >&2

if [[ -z "${CODEX_CLI_PATH:-}" ]]; then
  for candidate in \
    "$(command -v codex 2>/dev/null || true)" \
    /usr/bin/codex \
    /usr/local/bin/codex \
    "$HOME/.local/bin/codex" \
    "$HOME/.npm-global/bin/codex"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      export CODEX_CLI_PATH="$(readlink -f "$candidate")"
      break
    fi
  done
fi

flags=()
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
  if [[ -n "${DISPLAY:-}" ]]; then
    flags+=(--ozone-platform=x11)
  else
    flags+=(--ozone-platform=wayland --enable-features=WaylandWindowDecorations)
  fi
fi

flags_file="$config_dir/electron-flags.conf"
if [[ -r "$flags_file" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    flags+=("$line")
  done < "$flags_file"
fi

exec "$app_dir/run-chatgpt-linux.sh" "${flags[@]}" "$@"
